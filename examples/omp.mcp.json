{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "icon-forge": {
      "type": "stdio",
      "command": "node",
      "args": ["/absolute/path/to/icon-forge-mcp/server.mjs"],
      "cwd": "${PWD}",
      "timeout": 0,
      "env": {
        "CODEX_HOME": "/path/to/your/authenticated/codex-home",
        "ICON_FORGE_MAX_CONCURRENT_GENERATIONS": "2",
        "ICON_FORGE_TIMEOUT_MS": "240000"
      }
    }
  }
}
